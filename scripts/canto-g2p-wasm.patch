+    #[wasm_bindgen(constructor)]
+    pub fn new(
+        word: &[u8],
+        char_dict: &[u8],
+        separable: &[u8],
+        romanized_slang: &[u8],
+        classifier_words: &[u8],
+    ) -> Result<WasmPipeline, JsValue> {
+        let inner = pipeline::Pipeline::from_bytes(
+            word,
+            char_dict,
+            separable,
+            romanized_slang,
+            classifier_words,
+        )
+        .map_err(|e| JsValue::from_str(&e))?;
+        Ok(WasmPipeline { inner })
+    }
+
+    pub fn convert(&self, text: &str) -> String {
+        self.inner.convert(text)
+    }
+
+    /// Flat [token, jyutping, token, jyutping, …] word segments, so the
+    /// worker can split at word boundaries without cutting a word.
+    pub fn words(&self, text: &str) -> Vec<String> {
+        let mut out = Vec::new();
+        for (token, jyutping) in self.inner.words(text) {
+            out.push(token);
+            out.push(jyutping);
+        }
+        out
+    }
+}
