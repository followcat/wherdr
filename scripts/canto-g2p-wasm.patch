+    /// Load a `.bin` dict from bytes already in memory (WASM). The format and
+    /// validation are the same as `load()`, without an mmap or filesystem.
+    #[cfg(target_arch = "wasm32")]
+    pub fn from_bytes(bytes: Vec<u8>) -> Result<Self, String> {
+        if bytes.len() < HEADER_SIZE {
+            return Err(format!(
+                "file too short: {} bytes (need at least {HEADER_SIZE})",
+                bytes.len()
+            ));
+        }
+        if &bytes[0..4] != MAGIC {
+            return Err(format!(
+                "bad magic: expected {:?}, got {:?}",
+                MAGIC,
+                &bytes[0..4]
+            ));
+        }
+        let version = u32::from_le_bytes(bytes[4..8].try_into().unwrap());
+        if version != VERSION {
+            return Err(format!("unsupported version {version} (expected {VERSION})"));
+        }
+        let entry_count = u32::from_le_bytes(bytes[8..12].try_into().unwrap()) as usize;
+        let pool_size = u32::from_le_bytes(bytes[12..16].try_into().unwrap()) as usize;
+        let pool_offset = HEADER_SIZE + entry_count * ENTRY_SIZE;
+        let required = pool_offset + pool_size;
+        if bytes.len() < required {
+            return Err(format!(
+                "file too short: {} bytes (need {required} for {entry_count} entries + pool)",
+                bytes.len()
+            ));
+        }
+        let entry_ptr = bytes[HEADER_SIZE..].as_ptr();
+        let pool_ptr = bytes[pool_offset..].as_ptr();
+        Ok(Dict {
+            _bytes: bytes,
+            entry_ptr,
+            pool_ptr,
+            entry_count,
         })
     }
 
