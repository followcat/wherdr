#!/bin/sh
# wherdr installer — https://wherdr.dev/install
#
#   curl -fsSL https://wherdr.dev/install | sh
#
# On the v3 tree this installs nothing. v3 runs on herdr-core (hc), is not a
# Herdr plugin and installs beside v2, from git: this prints how, and where
# the guide is, then exits with an error so a script that chained it stops.
# v2's installer (a Herdr plugin) is on the 2.x branch:
# https://github.com/afloury/wherdr/blob/2.x/website/public/install
#
# Everything is inside main(), called on the last line: a download cut short
# runs nothing.
main() {
  GUIDE="https://github.com/afloury/wherdr/blob/v3/docs/migrate-from-v2.md"
  cat >&2 <<MSG
wherdr v3 is not installed by this script, and nothing was changed.

v3 runs on herdr-core (hc), not as a Herdr plugin. It installs beside a
running wherdr v2, which keeps its service, data, port and address:

  git clone -b v3 https://github.com/afloury/wherdr.git /tmp/wherdr-setup
  sh /tmp/wherdr-setup/scripts/install-v3-beside-v2.sh          # the plan
  sh /tmp/wherdr-setup/scripts/install-v3-beside-v2.sh --yes    # install

Guide: $GUIDE

To install or update wherdr v2 (the Herdr plugin) instead:
  curl -fsSL https://raw.githubusercontent.com/afloury/wherdr/2.x/website/public/install | WHERDR_REF=2.x sh
MSG
  exit 1
}

main "$@"
